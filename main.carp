(load "git@github.com:carpentry-org/file@0.3.0")
(load "git@github.com:carpentry-org/log@0.2.0")

(defmodule FileLog
  (def FILENAME "")

  (defn log- [r]
    ; crashing is the contract: a logger that cannot open its file must not
    ; carry on as though it logged
    ; angler-disable-next-line unsafe-result-unwrap
    (let-do [f (Result.unsafe-from-success (File.open-with FILENAME "a+"))]
      (ignore
        (Result.unsafe-from-success
          ; this forces a crash if we can’t write
          (File.write &f &(fmt "%s
" &(LogRecord.pretty r)))))
      (File.close f)))

  (defn install [filename lvl]
    (do (set! FILENAME filename) (Log.set-level lvl) (Log.set-logger log-))))
