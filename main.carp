(load "git@github.com:carpentry-org/file@0.1.2")
(load "git@github.com:carpentry-org/log@0.1.1")

(defmodule FileLog
  (def FILENAME "")

  (defn log- [r]
    (match (File.open-with FILENAME "a+")
      (Result.Success f) (do (ignore (File.write &f &(fmt "%s
" &(LogRecord.pretty r)))) (File.close f))
      (Result.Error _) ()))

  (defn install [filename lvl]
    (do (set! FILENAME filename) (Log.set-level lvl) (Log.set-logger log-))))
